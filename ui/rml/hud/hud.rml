<rml>
<head>
    <title>HUD</title>
    <style>
        body {
            font-family: LatoLatin;
            color: #ffffff;
            width: 100%;
            height: 100%;
        }
        .box {
            background-color: #00000098;
            border-radius: 6px;
        }
        img { image-color: #ffffffff; }

        /* ---- bottom-center: armor / face+health / ammo trio ---- */
        #trio {
            position: absolute;
            bottom: 18px;
            left: 50%;
            margin-left: -280px;
            width: 560px;
            text-align: center;
        }
        .cell {
            display: inline-block;
            width: 170px;
            padding: 8px 0;
            margin: 0 4px;
            vertical-align: bottom;
        }
        .cell img.icon { width: 48px; height: 48px; vertical-align: middle; }
        .cell .big { font-size: 42dp; font-weight: bold; vertical-align: middle; margin-left: 8px; }
        .low { color: #ff4040; }
        .mega { color: #60c0ff; }
        .ga { color: #40c040; }
        .ya { color: #e0c040; }
        .ra { color: #ff4040; }

        /* ---- weapon bar above the trio ---- */
        #weapons {
            position: absolute;
            bottom: 104px;
            left: 50%;
            margin-left: -280px;
            width: 560px;
            text-align: center;
        }
        .wslot {
            display: inline-block;
            padding: 4px 4px;
            margin: 0 1px;
            background-color: #00000060;
            border-radius: 4px;
        }
        .wslot img { width: 48px; height: 32px; image-color: #ffffff50; }
        .wslot.owned img { image-color: #ffffffff; }
        .wslot.owned { background-color: #00000098; }
        .wslot.active { background-color: #205080d0; }
        .wslot .axe {
            display: inline-block; width: 48px; font-size: 15dp;
            color: #707070; text-align: center; padding: 8px 0;
        }
        .wslot.owned .axe { color: #e0e0e0; }

        /* ---- bottom-right: per-type ammo + frags ---- */
        #inventory {
            position: absolute;
            right: 18px;
            bottom: 18px;
            padding: 8px 12px;
            font-size: 17dp;
            text-align: right;
        }
        #inventory .arow { display: block; color: #e0e0e0; margin: 2px 0; }
        #inventory .arow img { width: 24px; height: 24px; vertical-align: middle; margin-right: 6px; }
        #inventory .count { display: inline-block; width: 44px; vertical-align: middle; text-align: right; }
        #inventory .frags { display: block; font-size: 22dp; font-weight: bold; margin-top: 6px; }

        /* ---- bottom-left: powerups / keys / sigils / speed ---- */
        #status {
            position: absolute;
            left: 18px;
            bottom: 18px;
            padding: 8px 12px;
        }
        #status img { width: 32px; height: 32px; margin: 2px; vertical-align: middle; }
        #status .speed { display: block; color: #b0b0b0; font-size: 15dp; margin-top: 4px; }

        /* ---- top-right: clock / fps / ping ---- */
        #meta {
            position: absolute;
            right: 18px;
            top: 14px;
            padding: 6px 14px;
            font-size: 16dp;
            text-align: right;
        }
        #meta .clock { font-size: 24dp; font-weight: bold; display: block; }
        #meta .net { color: #b0b0b0; display: block; }

        /* ---- top-left: notify lines ---- */
        #notify {
            position: absolute;
            left: 12px;
            top: 10px;
            width: 45%;
            font-size: 15dp;
            color: #e8e8e8;
        }
        #notify .nline { display: block; }

        /* ---- centerprint ---- */
        #centerprint {
            position: absolute;
            top: 25%;
            left: 15%;
            width: 70%;
            text-align: center;
            font-size: 22dp;
            font-weight: bold;
            color: #ffe8a0;
            white-space: pre-line;
        }

        /* ---- scoreboard (+showscores) ---- */
        #scores {
            position: absolute;
            top: 18%;
            left: 50%;
            margin-left: -220px;
            width: 440px;
            padding: 10px 16px;
            font-size: 17dp;
        }
        #scores .title { font-size: 20dp; font-weight: bold; display: block; margin-bottom: 6px; color: #b0d0ff; }
        #scores .prow { display: block; }
        #scores .fr { display: inline-block; width: 56px; font-weight: bold; }
        #scores .pn { display: inline-block; width: 190px; }
        #scores .tm { display: inline-block; width: 90px; color: #b0b0b0; }
        #scores .pi { display: inline-block; width: 60px; color: #b0b0b0; text-align: right; }
        .specrow { color: #808080; }
    </style>
</head>

<!--
    Classic-icon HUD bound to the "hud" GameDataModel (M3.5).
    Icons are the original Quake sbar graphics, extracted from gfx.wad
    into icons/ (see CONTINUE.md). Faces/ammo boxes switch through the
    derived face_icon / ammo_icon model fields.
-->
<body data-model="hud">

    <!-- notify (console) lines -->
    <div id="notify">
        <div class="nline" data-for="line : notify_lines">{{ line }}</div>
    </div>

    <!-- clock / net -->
    <div id="meta" class="box">
        <span class="clock">{{ match_time }}</span>
        <span class="net">{{ fps }} fps &nbsp; {{ ping }} ms</span>
        <span class="net" data-if="spectator">SPEC</span>
        <span class="net" data-if="demo_playback">DEMO</span>
    </div>

    <!-- weapon bar: axe + 7 classic weapon pics, owned/active states -->
    <div id="weapons">
        <span class="wslot" data-class-owned="has_axe" data-class-active="weapon_num == 1"><span class="axe">AXE</span></span>
        <span class="wslot" data-class-owned="has_shotgun" data-class-active="weapon_num == 2"><img data-attr-src="weapon_num == 2 ? 'icons/inv2_shotgun.tga' : 'icons/inv_shotgun.tga'"/></span>
        <span class="wslot" data-class-owned="has_super_shotgun" data-class-active="weapon_num == 3"><img data-attr-src="weapon_num == 3 ? 'icons/inv2_sshotgun.tga' : 'icons/inv_sshotgun.tga'"/></span>
        <span class="wslot" data-class-owned="has_nailgun" data-class-active="weapon_num == 4"><img data-attr-src="weapon_num == 4 ? 'icons/inv2_nailgun.tga' : 'icons/inv_nailgun.tga'"/></span>
        <span class="wslot" data-class-owned="has_super_nailgun" data-class-active="weapon_num == 5"><img data-attr-src="weapon_num == 5 ? 'icons/inv2_snailgun.tga' : 'icons/inv_snailgun.tga'"/></span>
        <span class="wslot" data-class-owned="has_grenade_launcher" data-class-active="weapon_num == 6"><img data-attr-src="weapon_num == 6 ? 'icons/inv2_rlaunch.tga' : 'icons/inv_rlaunch.tga'"/></span>
        <span class="wslot" data-class-owned="has_rocket_launcher" data-class-active="weapon_num == 7"><img data-attr-src="weapon_num == 7 ? 'icons/inv2_srlaunch.tga' : 'icons/inv_srlaunch.tga'"/></span>
        <span class="wslot" data-class-owned="has_lightning" data-class-active="weapon_num == 8"><img data-attr-src="weapon_num == 8 ? 'icons/inv2_lightng.tga' : 'icons/inv_lightng.tga'"/></span>
    </div>

    <!-- armor / face+health / ammo -->
    <div id="trio">
        <div class="cell box" data-if="armor > 0">
            <img class="icon" data-if="armor_type == 1" src="icons/sb_armor1.tga"/>
            <img class="icon" data-if="armor_type == 2" src="icons/sb_armor2.tga"/>
            <img class="icon" data-if="armor_type == 3" src="icons/sb_armor3.tga"/>
            <span class="big"
                  data-class-ga="armor_type == 1"
                  data-class-ya="armor_type == 2"
                  data-class-ra="armor_type == 3">{{ armor }}</span>
        </div>
        <div class="cell box">
            <img class="icon" data-attr-src="'icons/' + face_icon + '.tga'"/>
            <span class="big" data-class-low="health &lt; 25" data-class-mega="health &gt; 100">{{ health }}</span>
        </div>
        <div class="cell box">
            <img class="icon" data-if="weapon_num &gt; 1" data-attr-src="'icons/' + ammo_icon + '.tga'"/>
            <span class="big" data-class-low="ammo &lt; 10">{{ ammo }}</span>
        </div>
    </div>

    <!-- per-type ammo + frags -->
    <div id="inventory" class="box">
        <span class="arow"><img src="icons/sb_shells.tga"/><span class="count">{{ shells }}</span></span>
        <span class="arow"><img src="icons/sb_nails.tga"/><span class="count">{{ nails }}</span></span>
        <span class="arow"><img src="icons/sb_rocket.tga"/><span class="count">{{ rockets }}</span></span>
        <span class="arow"><img src="icons/sb_cells.tga"/><span class="count">{{ cells }}</span></span>
        <span class="frags">frags {{ frags }}</span>
    </div>

    <!-- powerups / keys / sigils / speed -->
    <div id="status" class="box">
        <img data-if="quad" src="icons/sb_quad.tga"/>
        <img data-if="pent" src="icons/sb_invuln.tga"/>
        <img data-if="ring" src="icons/sb_invis.tga"/>
        <img data-if="suit" src="icons/sb_suit.tga"/>
        <img data-if="key1" src="icons/sb_key1.tga"/>
        <img data-if="key2" src="icons/sb_key2.tga"/>
        <img data-if="sigil1" src="icons/sb_sigil1.tga"/>
        <img data-if="sigil2" src="icons/sb_sigil2.tga"/>
        <img data-if="sigil3" src="icons/sb_sigil3.tga"/>
        <img data-if="sigil4" src="icons/sb_sigil4.tga"/>
        <span class="speed">{{ speed }} ups</span>
    </div>

    <!-- centerprint -->
    <div id="centerprint" data-if="centerprint_visible">{{ centerprint }}</div>

    <!-- scoreboard -->
    <div id="scores" class="box" data-if="showscores">
        <span class="title">{{ map }} &nbsp; {{ match_time }}</span>
        <div class="prow" data-for="p : players" data-class-specrow="p.spectator">
            <span class="fr">{{ p.frags }}</span>
            <span class="pn">{{ p.name }}</span>
            <span class="tm">{{ p.team }}</span>
            <span class="pi">{{ p.ping }}</span>
        </div>
    </div>

</body>
</rml>
