<rml>
<head>
    <title>HUD</title>
    <style>
        body {
            font-family: LatoLatin;
            color: #ffffff;
            width: 100%;
            height: 100%;
        }

        /* ============ classic status bar (sbar), 2x scale ============ */
        #sbar {
            position: absolute;
            bottom: 8px;
            left: 50%;
            margin-left: -320px;
            width: 640px;
            height: 52px;
            background-color: #00000050;
            text-align: center;
        }
        #sbar .group { display: inline-block; vertical-align: bottom; margin: 0 6px; }
        #sbar img.icon { width: 48px; height: 48px; vertical-align: bottom; }
        #sbar .digslot { display: inline-block; width: 40px; height: 48px; vertical-align: bottom; }
        #sbar .digslot img { width: 40px; height: 48px; }

        /* ============ inventory bar (ibar) above the sbar ============ */
        #ibar {
            position: absolute;
            bottom: 62px;
            left: 50%;
            margin-left: -320px;
            width: 640px;
            text-align: center;
        }
        #ibar .counts { display: block; font-size: 15dp; color: #e8d060; margin-bottom: 2px; }
        #ibar .counts img { width: 20px; height: 20px; vertical-align: middle; margin: 0 2px 0 10px; }
        #ibar .counts span { vertical-align: middle; }
        .wslot {
            display: inline-block;
            padding: 2px 2px;
            margin: 0;
            background-color: #00000040;
        }
        .wslot img { width: 48px; height: 32px; image-color: #ffffff60; }
        .wslot.owned img { image-color: #ffffffff; }
        .wslot.active { background-color: #30609078; }
        .wslot .axe {
            display: inline-block; width: 40px; font-size: 14dp;
            color: #808080; text-align: center; padding: 8px 0;
        }
        .wslot.owned .axe { color: #f0f0f0; }

        /* ============ items (powerups/keys/sigils), right of ibar ===== */
        #items {
            position: absolute;
            right: 18px;
            bottom: 62px;
        }
        #items img { width: 32px; height: 32px; margin: 1px; }

        /* ============ corners ============ */
        #frags {
            position: absolute;
            right: 18px;
            bottom: 14px;
            font-size: 24dp;
            font-weight: bold;
            color: #f0f0f0;
        }
        #speed {
            position: absolute;
            left: 18px;
            bottom: 14px;
            font-size: 15dp;
            color: #b0b0b0;
        }
        #meta {
            position: absolute;
            right: 18px;
            top: 14px;
            padding: 6px 14px;
            font-size: 16dp;
            text-align: right;
            background-color: #00000070;
            border-radius: 4px;
        }
        #meta .clock { font-size: 24dp; font-weight: bold; display: block; }
        #meta .net { color: #b0b0b0; display: block; }

        #notify {
            position: absolute;
            left: 12px;
            top: 10px;
            width: 45%;
            font-size: 15dp;
            color: #e8e8e8;
        }
        #notify .nline { display: block; }

        #centerprint {
            position: absolute;
            top: 25%;
            left: 15%;
            width: 70%;
            text-align: center;
            font-size: 22dp;
            font-weight: bold;
            color: #ffe8a0;
            white-space: pre-line;
        }

        #scores {
            position: absolute;
            top: 18%;
            left: 50%;
            margin-left: -220px;
            width: 440px;
            padding: 10px 16px;
            font-size: 17dp;
            background-color: #000000b0;
            border-radius: 6px;
        }
        #scores .title { font-size: 20dp; font-weight: bold; display: block; margin-bottom: 6px; color: #b0d0ff; }
        #scores .prow { display: block; }
        #scores .fr { display: inline-block; width: 56px; font-weight: bold; }
        #scores .pn { display: inline-block; width: 190px; }
        #scores .tm { display: inline-block; width: 90px; color: #b0b0b0; }
        #scores .pi { display: inline-block; width: 60px; color: #b0b0b0; text-align: right; }
        .specrow { color: #808080; }

        /* ---- edit mode (hud_newhudeditor_edit) ---- */
        #edithint { display: none; }
        body.edit #edithint {
            display: block;
            position: absolute;
            top: 6px;
            left: 50%;
            margin-left: -220px;
            width: 440px;
            text-align: center;
            font-size: 16dp;
            font-weight: bold;
            color: #ffe080;
            background-color: #000000b0;
            border-radius: 4px;
            padding: 6px 0;
        }
        body.edit > div {
            border: 1dp #60a0ff90;
        }
    </style>
</head>

<!--
    Classic status-bar recreation (M3.5 v3) bound to the "hud" model.
    Layout mirrors the original sbar/ibar: LCD digit lumps (num_/anum_),
    armor icon + digits | face | health digits | ammo icon + digits, with
    the weapon strip and mini ammo counts above, items to the right.
-->
<body data-model="hud">

    <div id="edithint">MODO EDIÇÃO — arraste os elementos · ESC para sair</div>

    <div id="notify">
        <div class="nline" data-for="line : notify_lines">{{ line }}</div>
    </div>

    <div id="meta">
        <span class="clock">{{ match_time }}</span>
        <span class="net">{{ fps }} fps &nbsp; {{ ping }} ms</span>
        <span class="net" data-if="spectator">SPEC</span>
        <span class="net" data-if="demo_playback">DEMO</span>
    </div>

    <!-- inventory bar: mini ammo counts + weapon strip -->
    <div id="ibar">
        <span class="counts">
            <img src="icons/sb_shells.tga"/><span>{{ shells }}</span>
            <img src="icons/sb_nails.tga"/><span>{{ nails }}</span>
            <img src="icons/sb_rocket.tga"/><span>{{ rockets }}</span>
            <img src="icons/sb_cells.tga"/><span>{{ cells }}</span>
        </span>
        <span class="wslot" data-class-owned="has_axe" data-class-active="weapon_num == 1"><span class="axe">AXE</span></span>
        <span class="wslot" data-class-owned="has_shotgun" data-class-active="weapon_num == 2"><img data-attr-src="weapon_num == 2 ? 'icons/inv2_shotgun.tga' : 'icons/inv_shotgun.tga'"/></span>
        <span class="wslot" data-class-owned="has_super_shotgun" data-class-active="weapon_num == 3"><img data-attr-src="weapon_num == 3 ? 'icons/inv2_sshotgun.tga' : 'icons/inv_sshotgun.tga'"/></span>
        <span class="wslot" data-class-owned="has_nailgun" data-class-active="weapon_num == 4"><img data-attr-src="weapon_num == 4 ? 'icons/inv2_nailgun.tga' : 'icons/inv_nailgun.tga'"/></span>
        <span class="wslot" data-class-owned="has_super_nailgun" data-class-active="weapon_num == 5"><img data-attr-src="weapon_num == 5 ? 'icons/inv2_snailgun.tga' : 'icons/inv_snailgun.tga'"/></span>
        <span class="wslot" data-class-owned="has_grenade_launcher" data-class-active="weapon_num == 6"><img data-attr-src="weapon_num == 6 ? 'icons/inv2_rlaunch.tga' : 'icons/inv_rlaunch.tga'"/></span>
        <span class="wslot" data-class-owned="has_rocket_launcher" data-class-active="weapon_num == 7"><img data-attr-src="weapon_num == 7 ? 'icons/inv2_srlaunch.tga' : 'icons/inv_srlaunch.tga'"/></span>
        <span class="wslot" data-class-owned="has_lightning" data-class-active="weapon_num == 8"><img data-attr-src="weapon_num == 8 ? 'icons/inv2_lightng.tga' : 'icons/inv_lightng.tga'"/></span>
    </div>

    <!-- items: powerups / keys / sigils -->
    <div id="items">
        <img data-if="quad" src="icons/sb_quad.tga"/>
        <img data-if="pent" src="icons/sb_invuln.tga"/>
        <img data-if="ring" src="icons/sb_invis.tga"/>
        <img data-if="suit" src="icons/sb_suit.tga"/>
        <img data-if="key1" src="icons/sb_key1.tga"/>
        <img data-if="key2" src="icons/sb_key2.tga"/>
        <img data-if="sigil1" src="icons/sb_sigil1.tga"/>
        <img data-if="sigil2" src="icons/sb_sigil2.tga"/>
        <img data-if="sigil3" src="icons/sb_sigil3.tga"/>
        <img data-if="sigil4" src="icons/sb_sigil4.tga"/>
    </div>

    <!-- classic status bar: armor | face | health | ammo -->
    <div id="sbar">
        <span class="group" data-if="armor > 0">
            <img class="icon" data-if="armor_type == 1" src="icons/sb_armor1.tga"/>
            <img class="icon" data-if="armor_type == 2" src="icons/sb_armor2.tga"/>
            <img class="icon" data-if="armor_type == 3" src="icons/sb_armor3.tga"/>
            <span class="digslot"><img data-if="armor_d100 != ''" data-attr-src="'icons/' + armor_d100 + '.tga'"/></span>
            <span class="digslot"><img data-if="armor_d10 != ''" data-attr-src="'icons/' + armor_d10 + '.tga'"/></span>
            <span class="digslot"><img data-if="armor_d1 != ''" data-attr-src="'icons/' + armor_d1 + '.tga'"/></span>
        </span>
        <span class="group">
            <img class="icon" data-attr-src="'icons/' + face_icon + '.tga'"/>
            <span class="digslot"><img data-if="health_d100 != ''" data-attr-src="'icons/' + health_d100 + '.tga'"/></span>
            <span class="digslot"><img data-if="health_d10 != ''" data-attr-src="'icons/' + health_d10 + '.tga'"/></span>
            <span class="digslot"><img data-if="health_d1 != ''" data-attr-src="'icons/' + health_d1 + '.tga'"/></span>
        </span>
        <span class="group" data-if="weapon_num &gt; 1">
            <img class="icon" data-attr-src="'icons/' + ammo_icon + '.tga'"/>
            <span class="digslot"><img data-if="ammo_d100 != ''" data-attr-src="'icons/' + ammo_d100 + '.tga'"/></span>
            <span class="digslot"><img data-if="ammo_d10 != ''" data-attr-src="'icons/' + ammo_d10 + '.tga'"/></span>
            <span class="digslot"><img data-if="ammo_d1 != ''" data-attr-src="'icons/' + ammo_d1 + '.tga'"/></span>
        </span>
    </div>

    <div id="frags">{{ frags }}</div>
    <div id="speed">{{ speed }} ups</div>

    <div id="centerprint" data-if="centerprint_visible">{{ centerprint }}</div>

    <div id="scores" data-if="showscores">
        <span class="title">{{ map }} &nbsp; {{ match_time }}</span>
        <div class="prow" data-for="p : players" data-class-specrow="p.spectator">
            <span class="fr">{{ p.frags }}</span>
            <span class="pn">{{ p.name }}</span>
            <span class="tm">{{ p.team }}</span>
            <span class="pi">{{ p.ping }}</span>
        </div>
    </div>

</body>
</rml>
