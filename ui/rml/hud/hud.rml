<rml>
<head>
    <title>HUD</title>
    <style>
        body {
            font-family: LatoLatin;
            color: #ffffff;
            width: 100%;
            height: 100%;
        }
        .widget { position: absolute; }

        /* ---- digit/icon helpers (classic 2x sbar) ---- */
        img.icon { width: 48px; height: 48px; vertical-align: bottom; }
        .digslot { display: inline-block; width: 40px; height: 48px; vertical-align: bottom; }
        .digslot img { width: 40px; height: 48px; }

        /* ---- health (face + digits) ---- */
        #w_health { left: 50%; margin-left: -84px; bottom: 12px; }
        /* ---- armor ---- */
        #w_armor { left: 50%; margin-left: -290px; bottom: 12px; }
        .ga img.tint, .arval.ga { color: #40c040; }
        /* ---- ammo ---- */
        #w_ammo { left: 50%; margin-left: 120px; bottom: 12px; }

        /* ---- weapon strip ---- */
        #w_weapons { left: 50%; margin-left: -196px; bottom: 70px; }
        .wslot {
            display: inline-block; padding: 2px; background-color: #00000040;
        }
        .wslot img { width: 48px; height: 32px; image-color: #ffffff60; }
        .wslot.owned img { image-color: #ffffffff; }
        .wslot.owned { background-color: #00000098; }
        .wslot.active { background-color: #30609078; }

        /* ---- per-type ammo counts ---- */
        #w_ammocounts {
            right: 18px; bottom: 66px; padding: 6px 10px;
            background-color: #00000090; border-radius: 5px;
            font-size: 16dp; text-align: right; color: #e8d060;
        }
        #w_ammocounts .arow { display: block; }
        #w_ammocounts img { width: 20px; height: 20px; vertical-align: middle; margin-right: 6px; }
        #w_ammocounts span { vertical-align: middle; }

        /* ---- items ---- */
        #w_items { right: 18px; bottom: 130px; }
        #w_items img { width: 32px; height: 32px; margin: 1px; }

        /* ---- frags / speed / clock ---- */
        #w_frags { right: 18px; bottom: 14px; font-size: 26dp; font-weight: bold; }
        #w_speed { left: 18px; bottom: 14px; font-size: 15dp; color: #b0b0b0; }
        #w_clock {
            right: 18px; top: 14px; padding: 6px 14px; text-align: right;
            background-color: #00000070; border-radius: 4px; font-size: 16dp;
        }
        #w_clock .clock { font-size: 24dp; font-weight: bold; display: block; }
        #w_clock .net { color: #b0b0b0; display: block; }

        /* ---- notify ---- */
        #w_notify { left: 12px; top: 10px; width: 45%; font-size: 15dp; color: #e8e8e8; }
        #w_notify .nline { display: block; }

        /* ---- centerprint ---- */
        #w_centerprint {
            top: 25%; left: 15%; width: 70%; text-align: center;
            font-size: 22dp; font-weight: bold; color: #ffe8a0; white-space: pre-line;
        }

        /* ---- scoreboard ---- */
        #w_scores {
            top: 15%; left: 50%; margin-left: -260px; width: 520px;
            padding: 12px 18px; background-color: #000000c8; border-radius: 8px; font-size: 17dp;
        }
        #w_scores .title { font-size: 22dp; font-weight: bold; display: block; text-align: center; color: #ffffff; }
        #w_scores .subtitle { font-size: 14dp; display: block; text-align: center; color: #909090; margin-bottom: 10px; }
        #w_scores .hrow { display: block; font-size: 13dp; color: #808080; border-bottom: 1dp #404040; padding-bottom: 3px; margin-bottom: 4px; }
        #w_scores .prow { display: block; padding: 2px 0; }
        #w_scores .chip { display: inline-block; width: 8px; height: 16px; vertical-align: middle; margin-right: 6px; }
        #w_scores .fr { display: inline-block; width: 52px; font-weight: bold; text-align: center; vertical-align: middle; border-radius: 3px; }
        #w_scores .pn { display: inline-block; width: 210px; vertical-align: middle; padding-left: 10px; }
        #w_scores .tm { display: inline-block; width: 90px; color: #b0b0b0; vertical-align: middle; }
        #w_scores .pi { display: inline-block; width: 55px; color: #b0b0b0; text-align: right; vertical-align: middle; }
        #w_scores .plc { display: inline-block; width: 45px; color: #806060; text-align: right; vertical-align: middle; }
        .specrow { color: #707070; font-size: 15dp; }

        /* ============ style picker (responsive, wraps, scrolls) ============ */
        #stylepicker {
            position: absolute;
            top: 8%;
            left: 50%;
            margin-left: -300px;
            width: 600px;
            max-height: 78%;
            overflow-y: auto;
            padding: 16px 18px;
            background-color: #101418f0;
            border-radius: 10px;
        }
        #stylepicker .ptitle { display: block; text-align: center; font-size: 22dp; font-weight: bold; color: #ffffff; }
        #stylepicker .psub { display: block; text-align: center; font-size: 13dp; color: #8090a0; margin-bottom: 12px; }
        #stylepicker .card {
            display: inline-block; width: 128px; margin: 5px; padding: 8px 6px;
            background-color: #1c2430; border: 2dp #2a3644; border-radius: 8px;
            text-align: center; vertical-align: top;
        }
        #stylepicker .card:hover { border: 2dp #5090d0; background-color: #223044; }
        #stylepicker .card.current { border: 2dp #60c060; }
        #stylepicker .card .cname { display: block; font-size: 14dp; font-weight: bold; color: #e8e8e8; margin-bottom: 6px; }
        #stylepicker .card .srow { display: block; margin: 2px 0; }
        #stylepicker .card img.snum { width: 20px; height: 25px; }
        #stylepicker .card img.sic { width: 24px; height: 24px; margin: 0 2px; }
        #stylepicker .card .cur { display: block; font-size: 11dp; color: #60c060; margin-top: 4px; }
        #styleclose {
            display: block; margin: 12px auto 2px auto; width: 120px; padding: 7px 0;
            text-align: center; font-size: 15dp; font-weight: bold; color: #ffffff;
            background-color: #304050; border-radius: 6px;
        }
        #styleclose:hover { background-color: #4a6078; }

        /* ---- edit mode ---- */
        #edithint { display: none; }
        body.edit #edithint {
            display: block; position: absolute; top: 6px; left: 50%; margin-left: -230px;
            width: 460px; text-align: center; font-size: 16dp; font-weight: bold;
            color: #ffe080; background-color: #000000c0; border-radius: 4px; padding: 6px 0;
        }
        body.edit .widget { border: 1dp #60a0ff90; background-color: #10305010; }
    </style>
</head>

<!--
    Each HUD element is an independent top-level widget (id "w_*") so the
    drag editor (hud_newhudeditor_edit) can move each one separately;
    positions persist per-id. Icons resolve through {{ iconpath }}
    (hud_newhudeditor_iconset / the visual style picker).
-->
<body data-model="hud">

    <div id="edithint">MODO EDIÇÃO — arraste cada elemento · ESC para sair</div>

    <div id="w_notify" class="widget">
        <div class="nline" data-for="line : notify_lines">{{ line }}</div>
    </div>

    <div id="w_clock" class="widget">
        <span class="clock">{{ match_time }}</span>
        <span class="net">{{ fps }} fps &nbsp; {{ ping }} ms</span>
        <span class="net" data-if="spectator">SPEC</span>
        <span class="net" data-if="demo_playback">DEMO</span>
    </div>

    <div id="w_weapons" class="widget">
        <span class="wslot" data-class-owned="has_shotgun" data-class-active="weapon_num == 2"><img data-attr-src="iconpath + (weapon_num == 2 ? 'inv2_shotgun' : 'inv_shotgun')"/></span>
        <span class="wslot" data-class-owned="has_super_shotgun" data-class-active="weapon_num == 3"><img data-attr-src="iconpath + (weapon_num == 3 ? 'inv2_sshotgun' : 'inv_sshotgun')"/></span>
        <span class="wslot" data-class-owned="has_nailgun" data-class-active="weapon_num == 4"><img data-attr-src="iconpath + (weapon_num == 4 ? 'inv2_nailgun' : 'inv_nailgun')"/></span>
        <span class="wslot" data-class-owned="has_super_nailgun" data-class-active="weapon_num == 5"><img data-attr-src="iconpath + (weapon_num == 5 ? 'inv2_snailgun' : 'inv_snailgun')"/></span>
        <span class="wslot" data-class-owned="has_grenade_launcher" data-class-active="weapon_num == 6"><img data-attr-src="iconpath + (weapon_num == 6 ? 'inv2_rlaunch' : 'inv_rlaunch')"/></span>
        <span class="wslot" data-class-owned="has_rocket_launcher" data-class-active="weapon_num == 7"><img data-attr-src="iconpath + (weapon_num == 7 ? 'inv2_srlaunch' : 'inv_srlaunch')"/></span>
        <span class="wslot" data-class-owned="has_lightning" data-class-active="weapon_num == 8"><img data-attr-src="iconpath + (weapon_num == 8 ? 'inv2_lightng' : 'inv_lightng')"/></span>
    </div>

    <div id="w_armor" class="widget" data-if="armor > 0">
        <img class="icon" data-if="armor_type == 1" data-attr-src="iconpath + 'sb_armor1'"/>
        <img class="icon" data-if="armor_type == 2" data-attr-src="iconpath + 'sb_armor2'"/>
        <img class="icon" data-if="armor_type == 3" data-attr-src="iconpath + 'sb_armor3'"/>
        <span class="digslot"><img data-if="armor_d100 != ''" data-attr-src="iconpath + armor_d100"/></span>
        <span class="digslot"><img data-if="armor_d10 != ''" data-attr-src="iconpath + armor_d10"/></span>
        <span class="digslot"><img data-if="armor_d1 != ''" data-attr-src="iconpath + armor_d1"/></span>
    </div>

    <div id="w_health" class="widget">
        <img class="icon" data-attr-src="iconpath + face_icon"/>
        <span class="digslot"><img data-if="health_d100 != ''" data-attr-src="iconpath + health_d100"/></span>
        <span class="digslot"><img data-if="health_d10 != ''" data-attr-src="iconpath + health_d10"/></span>
        <span class="digslot"><img data-if="health_d1 != ''" data-attr-src="iconpath + health_d1"/></span>
    </div>

    <div id="w_ammo" class="widget" data-if="weapon_num &gt; 1">
        <img class="icon" data-attr-src="iconpath + ammo_icon"/>
        <span class="digslot"><img data-if="ammo_d100 != ''" data-attr-src="iconpath + ammo_d100"/></span>
        <span class="digslot"><img data-if="ammo_d10 != ''" data-attr-src="iconpath + ammo_d10"/></span>
        <span class="digslot"><img data-if="ammo_d1 != ''" data-attr-src="iconpath + ammo_d1"/></span>
    </div>

    <div id="w_ammocounts" class="widget">
        <span class="arow"><img data-attr-src="iconpath + 'sb_shells'"/><span>{{ shells }}</span></span>
        <span class="arow"><img data-attr-src="iconpath + 'sb_nails'"/><span>{{ nails }}</span></span>
        <span class="arow"><img data-attr-src="iconpath + 'sb_rocket'"/><span>{{ rockets }}</span></span>
        <span class="arow"><img data-attr-src="iconpath + 'sb_cells'"/><span>{{ cells }}</span></span>
    </div>

    <div id="w_items" class="widget">
        <img data-if="quad" data-attr-src="iconpath + 'sb_quad'"/>
        <img data-if="pent" data-attr-src="iconpath + 'sb_invuln'"/>
        <img data-if="ring" data-attr-src="iconpath + 'sb_invis'"/>
        <img data-if="suit" data-attr-src="iconpath + 'sb_suit'"/>
        <img data-if="key1" data-attr-src="iconpath + 'sb_key1'"/>
        <img data-if="key2" data-attr-src="iconpath + 'sb_key2'"/>
        <img data-if="sigil1" data-attr-src="iconpath + 'sb_sigil1'"/>
        <img data-if="sigil2" data-attr-src="iconpath + 'sb_sigil2'"/>
        <img data-if="sigil3" data-attr-src="iconpath + 'sb_sigil3'"/>
        <img data-if="sigil4" data-attr-src="iconpath + 'sb_sigil4'"/>
    </div>

    <div id="w_frags" class="widget">{{ frags }}</div>
    <div id="w_speed" class="widget">{{ speed }} ups</div>

    <div id="w_centerprint" class="widget" data-if="centerprint_visible">{{ centerprint }}</div>

    <div id="w_scores" class="widget" data-if="showscores">
        <span class="title">{{ map_title }}</span>
        <span class="subtitle">{{ map }} &nbsp;·&nbsp; {{ match_time }}</span>
        <span class="hrow">
            <span class="chip"></span><span class="fr">frags</span>
            <span class="pn">player</span><span class="tm">team</span>
            <span class="pi">ping</span><span class="plc">pl</span>
        </span>
        <div class="prow" data-for="p : players" data-class-specrow="p.spectator">
            <span class="chip" data-style-background-color="p.tcolor"></span>
            <span class="fr" data-style-background-color="p.bcolor" data-if="!p.spectator">{{ p.frags }}</span>
            <span class="fr" data-if="p.spectator">spec</span>
            <span class="pn">{{ p.name }}</span>
            <span class="tm">{{ p.team }}</span>
            <span class="pi">{{ p.ping }}</span>
            <span class="plc">{{ p.pl }}</span>
        </div>
    </div>

    <!-- visual iconset picker: hover = live preview, click = apply -->
    <div id="stylepicker" data-if="stylepicker">
        <span class="ptitle">Estilo do HUD</span>
        <span class="psub">passe o mouse para experimentar · clique para aplicar · ESC fecha</span>
        <div class="card" data-for="s : iconsets"
             data-attr-setpath="s.path"
             data-class-current="s.path == iconpath">
            <span class="cname">{{ s.name }}</span>
            <span class="srow">
                <img class="snum" data-attr-src="s.path + 'num_1'"/>
                <img class="snum" data-attr-src="s.path + 'num_0'"/>
                <img class="snum" data-attr-src="s.path + 'num_0'"/>
            </span>
            <span class="srow">
                <img class="sic" data-attr-src="s.path + 'sb_shells'"/>
                <img class="sic" data-attr-src="s.path + 'sb_armor1'"/>
                <img class="sic" data-attr-src="s.path + 'sb_quad'"/>
            </span>
            <span class="cur" data-if="s.path == iconpath">✓ em uso</span>
        </div>
        <div id="styleclose">Fechar</div>
    </div>

</body>
</rml>
