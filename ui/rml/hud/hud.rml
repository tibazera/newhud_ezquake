<rml>
<head>
    <title>HUD</title>
    <style>
        body {
            font-family: LatoLatin;
            color: #ffffff;
            width: 100%;
            height: 100%;
        }

        /* ============ classic status bar (sbar), 2x scale ============ */
        #sbar {
            position: absolute;
            bottom: 8px;
            left: 50%;
            margin-left: -320px;
            width: 640px;
            height: 52px;
            background-color: #00000050;
            text-align: center;
        }
        #sbar .group { display: inline-block; vertical-align: bottom; margin: 0 6px; }
        #sbar img.icon { width: 48px; height: 48px; vertical-align: bottom; }
        #sbar .digslot { display: inline-block; width: 40px; height: 48px; vertical-align: bottom; }
        #sbar .digslot img { width: 40px; height: 48px; }

        /* ============ inventory bar (ibar) above the sbar ============ */
        #ibar {
            position: absolute;
            bottom: 62px;
            left: 50%;
            margin-left: -320px;
            width: 640px;
            text-align: center;
        }
        #ibar .counts { display: block; font-size: 15dp; color: #e8d060; margin-bottom: 2px; }
        #ibar .counts img { width: 20px; height: 20px; vertical-align: middle; margin: 0 2px 0 10px; }
        #ibar .counts span { vertical-align: middle; }
        .wslot {
            display: inline-block;
            padding: 2px 2px;
            margin: 0;
            background-color: #00000040;
        }
        .wslot img { width: 48px; height: 32px; image-color: #ffffff60; }
        .wslot.owned img { image-color: #ffffffff; }
        .wslot.active { background-color: #30609078; }

        /* ============ items (powerups/keys/sigils), right of ibar ===== */
        #items {
            position: absolute;
            right: 18px;
            bottom: 62px;
        }
        #items img { width: 32px; height: 32px; margin: 1px; }

        /* ============ corners ============ */
        #frags {
            position: absolute;
            right: 18px;
            bottom: 14px;
            font-size: 24dp;
            font-weight: bold;
            color: #f0f0f0;
        }
        #speed {
            position: absolute;
            left: 18px;
            bottom: 14px;
            font-size: 15dp;
            color: #b0b0b0;
        }
        #meta {
            position: absolute;
            right: 18px;
            top: 14px;
            padding: 6px 14px;
            font-size: 16dp;
            text-align: right;
            background-color: #00000070;
            border-radius: 4px;
        }
        #meta .clock { font-size: 24dp; font-weight: bold; display: block; }
        #meta .net { color: #b0b0b0; display: block; }

        #notify {
            position: absolute;
            left: 12px;
            top: 10px;
            width: 45%;
            font-size: 15dp;
            color: #e8e8e8;
        }
        #notify .nline { display: block; }

        #centerprint {
            position: absolute;
            top: 25%;
            left: 15%;
            width: 70%;
            text-align: center;
            font-size: 22dp;
            font-weight: bold;
            color: #ffe8a0;
            white-space: pre-line;
        }

        /* ============ scoreboard (+showscores) ============ */
        #scores {
            position: absolute;
            top: 15%;
            left: 50%;
            margin-left: -260px;
            width: 520px;
            padding: 12px 18px;
            font-size: 17dp;
            background-color: #000000c8;
            border-radius: 8px;
        }
        #scores .title {
            font-size: 22dp; font-weight: bold; display: block;
            margin-bottom: 8px; color: #ffffff; text-align: center;
        }
        #scores .subtitle {
            font-size: 14dp; display: block; margin-bottom: 10px;
            color: #909090; text-align: center;
        }
        #scores .hrow {
            display: block; font-size: 13dp; color: #808080;
            border-bottom: 1dp #404040; padding-bottom: 3px; margin-bottom: 4px;
        }
        #scores .prow { display: block; padding: 2px 0; }
        #scores .chip {
            display: inline-block; width: 8px; height: 16px;
            vertical-align: middle; margin-right: 6px;
        }
        #scores .fr {
            display: inline-block; width: 52px; font-weight: bold;
            text-align: center; vertical-align: middle;
            border-radius: 3px; color: #ffffff;
        }
        #scores .pn { display: inline-block; width: 210px; vertical-align: middle; padding-left: 10px; }
        #scores .tm { display: inline-block; width: 90px; color: #b0b0b0; vertical-align: middle; }
        #scores .pi { display: inline-block; width: 55px; color: #b0b0b0; text-align: right; vertical-align: middle; }
        #scores .plc { display: inline-block; width: 45px; color: #806060; text-align: right; vertical-align: middle; }
        .specrow { color: #707070; font-size: 15dp; }

        /* ---- style picker (hud_newhudeditor_style) ---- */
        #stylepicker {
            position: absolute;
            top: 12%;
            left: 50%;
            margin-left: -330px;
            width: 660px;
            padding: 16px 20px;
            background-color: #101418e8;
            border-radius: 10px;
        }
        #stylepicker .ptitle {
            display: block; text-align: center;
            font-size: 24dp; font-weight: bold; color: #ffffff;
            margin-bottom: 2px;
        }
        #stylepicker .psub {
            display: block; text-align: center;
            font-size: 14dp; color: #8090a0; margin-bottom: 14px;
        }
        #stylepicker .card {
            display: inline-block;
            width: 190px;
            margin: 6px;
            padding: 10px 8px;
            background-color: #1c2430;
            border: 2dp #2a3644;
            border-radius: 8px;
            text-align: center;
            vertical-align: top;
        }
        #stylepicker .card:hover { border: 2dp #5090d0; background-color: #223044; }
        #stylepicker .card.current { border: 2dp #60c060; }
        #stylepicker .card .cname {
            display: block; font-size: 16dp; font-weight: bold;
            color: #e8e8e8; margin-bottom: 8px;
        }
        #stylepicker .card img.sample-num { width: 26px; height: 32px; }
        #stylepicker .card img.sample-icon { width: 32px; height: 32px; margin-left: 8px; }
        #stylepicker .card .srow { display: block; margin: 3px 0; }
        #stylepicker .card .cur {
            display: block; font-size: 12dp; color: #60c060; margin-top: 6px;
        }
        #styleclose {
            display: block;
            margin: 14px auto 0 auto;
            width: 120px;
            padding: 7px 0;
            text-align: center;
            font-size: 15dp; font-weight: bold;
            color: #ffffff;
            background-color: #304050;
            border-radius: 6px;
        }
        #styleclose:hover { background-color: #4a6078; }

        /* ---- edit mode (hud_newhudeditor_edit) ---- */
        #edithint { display: none; }
        body.edit #edithint {
            display: block;
            position: absolute;
            top: 6px;
            left: 50%;
            margin-left: -220px;
            width: 440px;
            text-align: center;
            font-size: 16dp;
            font-weight: bold;
            color: #ffe080;
            background-color: #000000b0;
            border-radius: 4px;
            padding: 6px 0;
        }
        body.edit > div {
            border: 1dp #60a0ff90;
        }
    </style>
</head>

<!--
    Classic status-bar HUD bound to the "hud" GameDataModel.
    All icons resolve through {{ iconpath }} (cvar hud_newhudeditor_iconset,
    extensionless names - the engine tries .tga/.png/.jpg), so community
    HUD packs installed in qw/textures/wad/ can be selected with
    `hud_newhudeditor_iconset "/textures/wad/"`.
-->
<body data-model="hud">

    <div id="edithint">MODO EDIÇÃO — arraste os elementos · ESC para sair</div>

    <div id="notify">
        <div class="nline" data-for="line : notify_lines">{{ line }}</div>
    </div>

    <div id="meta">
        <span class="clock">{{ match_time }}</span>
        <span class="net">{{ fps }} fps &nbsp; {{ ping }} ms</span>
        <span class="net" data-if="spectator">SPEC</span>
        <span class="net" data-if="demo_playback">DEMO</span>
    </div>

    <!-- inventory bar: mini ammo counts + weapon strip (weapons 2-8,
         like the original ibar - the axe has no classic pic) -->
    <div id="ibar">
        <span class="counts">
            <img data-attr-src="iconpath + 'sb_shells'"/><span>{{ shells }}</span>
            <img data-attr-src="iconpath + 'sb_nails'"/><span>{{ nails }}</span>
            <img data-attr-src="iconpath + 'sb_rocket'"/><span>{{ rockets }}</span>
            <img data-attr-src="iconpath + 'sb_cells'"/><span>{{ cells }}</span>
        </span>
        <span class="wslot" data-class-owned="has_shotgun" data-class-active="weapon_num == 2"><img data-attr-src="iconpath + (weapon_num == 2 ? 'inv2_shotgun' : 'inv_shotgun')"/></span>
        <span class="wslot" data-class-owned="has_super_shotgun" data-class-active="weapon_num == 3"><img data-attr-src="iconpath + (weapon_num == 3 ? 'inv2_sshotgun' : 'inv_sshotgun')"/></span>
        <span class="wslot" data-class-owned="has_nailgun" data-class-active="weapon_num == 4"><img data-attr-src="iconpath + (weapon_num == 4 ? 'inv2_nailgun' : 'inv_nailgun')"/></span>
        <span class="wslot" data-class-owned="has_super_nailgun" data-class-active="weapon_num == 5"><img data-attr-src="iconpath + (weapon_num == 5 ? 'inv2_snailgun' : 'inv_snailgun')"/></span>
        <span class="wslot" data-class-owned="has_grenade_launcher" data-class-active="weapon_num == 6"><img data-attr-src="iconpath + (weapon_num == 6 ? 'inv2_rlaunch' : 'inv_rlaunch')"/></span>
        <span class="wslot" data-class-owned="has_rocket_launcher" data-class-active="weapon_num == 7"><img data-attr-src="iconpath + (weapon_num == 7 ? 'inv2_srlaunch' : 'inv_srlaunch')"/></span>
        <span class="wslot" data-class-owned="has_lightning" data-class-active="weapon_num == 8"><img data-attr-src="iconpath + (weapon_num == 8 ? 'inv2_lightng' : 'inv_lightng')"/></span>
    </div>

    <!-- items: powerups / keys / sigils -->
    <div id="items">
        <img data-if="quad" data-attr-src="iconpath + 'sb_quad'"/>
        <img data-if="pent" data-attr-src="iconpath + 'sb_invuln'"/>
        <img data-if="ring" data-attr-src="iconpath + 'sb_invis'"/>
        <img data-if="suit" data-attr-src="iconpath + 'sb_suit'"/>
        <img data-if="key1" data-attr-src="iconpath + 'sb_key1'"/>
        <img data-if="key2" data-attr-src="iconpath + 'sb_key2'"/>
        <img data-if="sigil1" data-attr-src="iconpath + 'sb_sigil1'"/>
        <img data-if="sigil2" data-attr-src="iconpath + 'sb_sigil2'"/>
        <img data-if="sigil3" data-attr-src="iconpath + 'sb_sigil3'"/>
        <img data-if="sigil4" data-attr-src="iconpath + 'sb_sigil4'"/>
    </div>

    <!-- classic status bar: armor | face | health | ammo -->
    <div id="sbar">
        <span class="group" data-if="armor > 0">
            <img class="icon" data-if="armor_type == 1" data-attr-src="iconpath + 'sb_armor1'"/>
            <img class="icon" data-if="armor_type == 2" data-attr-src="iconpath + 'sb_armor2'"/>
            <img class="icon" data-if="armor_type == 3" data-attr-src="iconpath + 'sb_armor3'"/>
            <span class="digslot"><img data-if="armor_d100 != ''" data-attr-src="iconpath + armor_d100"/></span>
            <span class="digslot"><img data-if="armor_d10 != ''" data-attr-src="iconpath + armor_d10"/></span>
            <span class="digslot"><img data-if="armor_d1 != ''" data-attr-src="iconpath + armor_d1"/></span>
        </span>
        <span class="group">
            <img class="icon" data-attr-src="iconpath + face_icon"/>
            <span class="digslot"><img data-if="health_d100 != ''" data-attr-src="iconpath + health_d100"/></span>
            <span class="digslot"><img data-if="health_d10 != ''" data-attr-src="iconpath + health_d10"/></span>
            <span class="digslot"><img data-if="health_d1 != ''" data-attr-src="iconpath + health_d1"/></span>
        </span>
        <span class="group" data-if="weapon_num &gt; 1">
            <img class="icon" data-attr-src="iconpath + ammo_icon"/>
            <span class="digslot"><img data-if="ammo_d100 != ''" data-attr-src="iconpath + ammo_d100"/></span>
            <span class="digslot"><img data-if="ammo_d10 != ''" data-attr-src="iconpath + ammo_d10"/></span>
            <span class="digslot"><img data-if="ammo_d1 != ''" data-attr-src="iconpath + ammo_d1"/></span>
        </span>
    </div>

    <div id="frags">{{ frags }}</div>
    <div id="speed">{{ speed }} ups</div>

    <div id="centerprint" data-if="centerprint_visible">{{ centerprint }}</div>

    <!-- visual iconset picker: hover = live full-HUD preview, click = apply -->
    <div id="stylepicker" data-if="stylepicker">
        <span class="ptitle">Estilo do HUD</span>
        <span class="psub">passe o mouse para experimentar ao vivo · clique para aplicar</span>
        <div class="card" data-for="s : iconsets"
             data-attr-setpath="s.path"
             data-class-current="s.path == iconpath">
            <span class="cname">{{ s.name }}</span>
            <span class="srow">
                <img class="sample-num" data-attr-src="s.path + 'num_1'"/>
                <img class="sample-num" data-attr-src="s.path + 'num_0'"/>
                <img class="sample-num" data-attr-src="s.path + 'num_0'"/>
            </span>
            <span class="srow">
                <img class="sample-icon" data-attr-src="s.path + 'sb_shells'"/>
                <img class="sample-icon" data-attr-src="s.path + 'sb_armor1'"/>
                <img class="sample-icon" data-attr-src="s.path + 'sb_quad'"/>
            </span>
            <span class="cur" data-if="s.path == iconpath">✓ em uso</span>
        </div>
        <div id="styleclose">Fechar</div>
    </div>

    <!-- scoreboard: sorted by frags, quake team colours, spectators last -->
    <div id="scores" data-if="showscores">
        <span class="title">{{ map_title }}</span>
        <span class="subtitle">{{ map }} &nbsp;·&nbsp; {{ match_time }}</span>
        <span class="hrow">
            <span class="chip"></span>
            <span class="fr">frags</span>
            <span class="pn">player</span>
            <span class="tm">team</span>
            <span class="pi">ping</span>
            <span class="plc">pl</span>
        </span>
        <div class="prow" data-for="p : players" data-class-specrow="p.spectator">
            <span class="chip" data-style-background-color="p.tcolor"></span>
            <span class="fr" data-style-background-color="p.bcolor" data-if="!p.spectator">{{ p.frags }}</span>
            <span class="fr" data-if="p.spectator">spec</span>
            <span class="pn">{{ p.name }}</span>
            <span class="tm">{{ p.team }}</span>
            <span class="pi">{{ p.ping }}</span>
            <span class="plc">{{ p.pl }}</span>
        </div>
    </div>

</body>
</rml>
