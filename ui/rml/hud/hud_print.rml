<rml>
<head>
    <title>HUD Competitivo</title>
    <style>
        body {
            font-family: LatoLatin;
            color: #ffffff;
            width: 100%;
            height: 100%;
        }
        .widget { position: absolute; }

        /* ================= big bottom numbers (competitive/print) =================
           Each stat is a separate draggable widget. Defaults form the classic
           centered cluster: armor | +health | ammo, weapon icon above. */

        .bignum { font-size: 46dp; font-weight: bold; }

        /* --- armor: colored by armor type (green/yellow/red) --- */
        #w_armor { left: 38%; bottom: 3%; }
        #w_armor .bignum { color: #d05050; }                 /* default / RA */
        #w_armor.ga .bignum { color: #46c850; }              /* green armor */
        #w_armor.ya .bignum { color: #e0c040; }              /* yellow armor */
        #w_armor.ra .bignum { color: #e05050; }              /* red armor */

        /* --- health: green "+" and value colored by amount --- */
        #w_health { left: 50%; margin-left: -40dp; bottom: 3%; }
        #w_health .plus { color: #46c850; font-size: 46dp; font-weight: bold; }
        #w_health .bignum { color: #ffffff; }
        #w_health.mega .bignum { color: #46c850; }           /* > 100 (mega) */
        #w_health.low .bignum { color: #e05050; }            /* <= 25 */

        /* --- ammo: type icon + value --- */
        #w_ammo { left: 62%; bottom: 3%; }
        #w_ammo img { width: 30dp; height: 30dp; vertical-align: middle; margin-right: 6dp; }
        #w_ammo .bignum { color: #ffffff; vertical-align: middle; }

        /* --- active weapon icon (above the cluster) --- */
        #w_curweapon { left: 50%; margin-left: -24dp; bottom: 14%; }
        #w_curweapon img { width: 48dp; height: 32dp; }

        /* --- per-type ammo counts grid (2x2) --- */
        #w_ammocounts {
            right: 30%; bottom: 4%; padding: 4dp 8dp;
            background-color: #00000070; border-radius: 4dp;
            font-size: 15dp; color: #d8c060;
        }
        #w_ammocounts .arow { display: block; }
        #w_ammocounts .acell { display: inline-block; width: 58dp; }
        #w_ammocounts img { width: 16dp; height: 16dp; vertical-align: middle; margin-right: 4dp; }
        #w_ammocounts span { vertical-align: middle; }

        /* --- items / powerups --- */
        #w_items { right: 2%; bottom: 30%; }
        #w_items img { width: 28dp; height: 28dp; margin: 1dp; }

        /* ---- corners ---- */
        #w_frags { right: 2%; bottom: 3%; font-size: 26dp; font-weight: bold; }
        #w_speed { left: 2%; bottom: 3%; font-size: 14dp; color: #b0b0b0; }
        #w_clock {
            right: 2%; top: 2%; padding: 3dp 10dp; text-align: right;
            background-color: #00000070; border-radius: 4dp;
        }
        #w_clock .clock { font-size: 22dp; font-weight: bold; }
        #w_fps {
            right: 2%; top: 10%; padding: 3dp 10dp; text-align: right;
            background-color: #00000070; border-radius: 4dp; font-size: 13dp; color: #b0b0b0;
        }

        /* --- face (optional in this layout) --- */
        #w_face { left: 50%; margin-left: -80dp; bottom: 3%; }
        #w_face img { width: 40dp; height: 40dp; }

        /* --- full weapon strip (centered) --- */
        #w_weapons { left: 0; right: 0; bottom: 22%; text-align: center; }
        #w_weapons .wslot { display: inline-block; padding: 1dp; background-color: #00000040; }
        #w_weapons .wslot img { width: 40dp; height: 26dp; image-color: #ffffff60; }
        #w_weapons .wslot.owned img { image-color: #ffffffff; }
        #w_weapons .wslot.owned { background-color: #00000098; }
        #w_weapons .wslot.active { background-color: #30609078; }

        /* ---- kill feed (deaths) ---- */
        #w_deaths { left: 1%; top: 2%; width: 44%; font-size: 13dp; font-weight: bold; color: #ff7060; }
        #w_deaths .dline { display: block; }

        /* ---- notify / centerprint ---- */
        #w_notify { left: 1%; top: 22%; width: 46%; font-size: 14dp; color: #e8e8e8; }
        #w_notify .nline { display: block; }
        #w_centerprint {
            top: 30%; left: 15%; width: 70%; text-align: center;
            font-size: 24dp; font-weight: bold; color: #ffffff; white-space: pre-line;
        }

        /* ---- style picker: centered via left:50% + negative margin-left ---- */
        #stylepicker {
            position: absolute; top: 34dp; left: 50%; width: 280dp; margin-left: -140dp;
            padding: 12dp; background-color: #0b1015f2;
            border: 2dp #34506e; border-radius: 8dp;
        }
        #stylepicker .ptitle { display: block; text-align: center; font-size: 20dp; font-weight: bold; color: #ffffff; margin-bottom: 2dp; }
        #stylepicker .psub { display: block; text-align: center; font-size: 11dp; color: #8090a0; margin-bottom: 8dp; }
        #stylepicker .seclbl { display: block; font-size: 11dp; color: #6d7d90; margin: 10dp 0 3dp 0; }
        #stylepicker .row {
            display: block; padding: 8dp 10dp; margin: 3dp 0; border-radius: 5dp;
            background-color: #1a2230; border: 2dp #1a2230;
            font-size: 14dp; font-weight: bold; color: #d8dee6;
        }
        #stylepicker .row:hover { border: 2dp #3a5a80; }
        #stylepicker .row.current { background-color: #16281a; color: #8fe0a0; border-color: #2f6a3a; }
        #stylepicker .row.sel { border: 2dp #5aa0e0; background-color: #223448; color: #ffffff; }
        #stylepicker .scur { display: inline-block; font-size: 11dp; color: #60c060; margin-left: 8dp; }
        #styleclose {
            display: block; margin: 10dp auto 0 auto; width: 110dp; padding: 7dp 0;
            text-align: center; font-size: 13dp; font-weight: bold; color: #ffffff;
            background-color: #304050; border-radius: 5dp;
        }
        #styleclose:hover { background-color: #4a6078; }

        /* ---- config panel (edit mode) ---- */
        #configpanel {
            position: absolute; top: 16%; left: 2%;
            width: 210dp; padding: 12dp 14dp;
            background-color: #0d1016f2; border: 1dp #33465c; border-radius: 8dp;
        }
        #configpanel .ctitle { display: block; font-size: 15dp; font-weight: bold; color: #ffffff; margin-bottom: 3dp; }
        #configpanel .chelp { display: block; font-size: 12dp; color: #7d8ba0; margin-bottom: 10dp; }
        #configpanel .crow {
            display: block; padding: 5dp 6dp; margin: 1dp 0; border-radius: 4dp;
            font-size: 14dp; color: #c0c8d2;
        }
        #configpanel .crow:hover { background-color: #ffffff10; }
        #configpanel .cbox {
            display: inline-block; width: 16dp; height: 16dp; vertical-align: middle;
            margin-right: 8dp; border: 1dp #5a6b7e; border-radius: 3dp; text-align: center;
            font-size: 13dp; color: #60c060;
        }
        #configpanel .crow.on .cbox { background-color: #2a5a2a; }
        #configpanel .crow.off { color: #6a7280; }

        /* ---- edit mode ---- */
        #edithint {
            position: absolute; top: 0; left: 0; right: 0;
            padding: 6dp 16dp; text-align: center; font-size: 15dp; font-weight: bold;
            color: #ffe080; background-color: #000000c0;
        }
        body.edit .widget { border: 1dp #60a0ff90; background-color: #10305010; }
        .whidden { display: none; }
    </style>
</head>

<!--
    "Competitivo" layout — big colored numbers, modelled on the classic KTX
    QuakeWorld HUD. Kill feed / team overlay / team scores / scoreboard come
    from the engine's classic drawing (player cfg driven). Each number is a
    separate draggable widget (id "w_*"), authored in conwidth/conheight space.
-->
<body data-model="hud">

    <div id="edithint" data-if="editmode">MODO EDIÇÃO — arraste cada elemento · ESC para sair</div>

    <div id="w_notify" class="widget">
        <div class="nline" data-for="line : notify_lines">{{ line }}</div>
    </div>

    <div id="w_clock" class="widget">
        <span class="clock">{{ match_time }}</span>
    </div>

    <div id="w_fps" class="widget">
        <span>{{ fps }} fps</span>
    </div>

    <!-- kill feed (deaths) -->
    <div id="w_deaths" class="widget">
        <div class="dline" data-for="d : deaths">{{ d }}</div>
    </div>

    <!-- face -->
    <div id="w_face" class="widget">
        <img data-attr-src="iconpath + face_icon"/>
    </div>

    <!-- full weapon strip (highlights the active one) -->
    <div id="w_weapons" class="widget">
        <span class="wslot" data-class-owned="has_shotgun" data-class-active="weapon_num == 2"><img data-attr-src="iconpath + (weapon_num == 2 ? 'inv2_shotgun' : 'inv_shotgun')"/></span>
        <span class="wslot" data-class-owned="has_super_shotgun" data-class-active="weapon_num == 3"><img data-attr-src="iconpath + (weapon_num == 3 ? 'inv2_sshotgun' : 'inv_sshotgun')"/></span>
        <span class="wslot" data-class-owned="has_nailgun" data-class-active="weapon_num == 4"><img data-attr-src="iconpath + (weapon_num == 4 ? 'inv2_nailgun' : 'inv_nailgun')"/></span>
        <span class="wslot" data-class-owned="has_super_nailgun" data-class-active="weapon_num == 5"><img data-attr-src="iconpath + (weapon_num == 5 ? 'inv2_snailgun' : 'inv_snailgun')"/></span>
        <span class="wslot" data-class-owned="has_grenade_launcher" data-class-active="weapon_num == 6"><img data-attr-src="iconpath + (weapon_num == 6 ? 'inv2_rlaunch' : 'inv_rlaunch')"/></span>
        <span class="wslot" data-class-owned="has_rocket_launcher" data-class-active="weapon_num == 7"><img data-attr-src="iconpath + (weapon_num == 7 ? 'inv2_srlaunch' : 'inv_srlaunch')"/></span>
        <span class="wslot" data-class-owned="has_lightning" data-class-active="weapon_num == 8"><img data-attr-src="iconpath + (weapon_num == 8 ? 'inv2_lightng' : 'inv_lightng')"/></span>
    </div>

    <!-- armor: colored by type -->
    <div id="w_armor" class="widget"
         data-class-ga="armor_type == 1"
         data-class-ya="armor_type == 2"
         data-class-ra="armor_type == 3">
        <span class="bignum">{{ armor }}</span>
    </div>

    <!-- health: green plus + colored value -->
    <div id="w_health" class="widget"
         data-class-mega="health &gt; 100"
         data-class-low="health &lt;= 25">
        <span class="plus">+</span><span class="bignum">{{ health }}</span>
    </div>

    <!-- ammo for the active weapon: icon + value -->
    <div id="w_ammo" class="widget" data-if="weapon_num &gt; 1">
        <img data-attr-src="iconpath + ammo_icon"/><span class="bignum">{{ ammo }}</span>
    </div>

    <!-- per-type ammo counts (2x2 grid) -->
    <div id="w_ammocounts" class="widget">
        <span class="arow">
            <span class="acell"><img data-attr-src="iconpath + 'sb_shells'"/><span>{{ shells }}</span></span>
            <span class="acell"><img data-attr-src="iconpath + 'sb_nails'"/><span>{{ nails }}</span></span>
        </span>
        <span class="arow">
            <span class="acell"><img data-attr-src="iconpath + 'sb_rocket'"/><span>{{ rockets }}</span></span>
            <span class="acell"><img data-attr-src="iconpath + 'sb_cells'"/><span>{{ cells }}</span></span>
        </span>
    </div>

    <!-- items / powerups -->
    <div id="w_items" class="widget">
        <img data-if="quad" data-attr-src="iconpath + 'sb_quad'"/>
        <img data-if="pent" data-attr-src="iconpath + 'sb_invuln'"/>
        <img data-if="ring" data-attr-src="iconpath + 'sb_invis'"/>
        <img data-if="suit" data-attr-src="iconpath + 'sb_suit'"/>
        <img data-if="key1" data-attr-src="iconpath + 'sb_key1'"/>
        <img data-if="key2" data-attr-src="iconpath + 'sb_key2'"/>
    </div>

    <div id="w_frags" class="widget">{{ frags }}</div>
    <div id="w_speed" class="widget">{{ speed }} ups</div>

    <div id="w_centerprint" class="widget" data-if="centerprint_visible">{{ centerprint }}</div>

    <!-- edit-mode config panel -->
    <div id="configpanel" data-if="editmode">
        <span class="ctitle">Elementos do HUD</span>
        <span class="chelp">clique para mostrar/ocultar · arraste cada um na tela</span>
        <div class="crow" data-for="w : widgets"
             data-attr-wid="w.id"
             data-class-on="w.visible"
             data-class-off="!w.visible">
            <span class="cbox">{{ w.visible ? '✓' : '' }}</span>{{ w.label }}
        </div>
    </div>

    <!-- picker: layout presets on top, then iconsets -->
    <div id="stylepicker" data-if="stylepicker">
        <span class="ptitle">Estilo do HUD</span>
        <span class="psub">Setas navegam ícones · Enter aplica · ESC fecha</span>

        <span class="seclbl">LAYOUT</span>
        <div class="row" data-for="l : layouts"
             data-attr-setdoc="l.path"
             data-class-current="l.path == layoutpath">
            {{ l.name }}
        </div>

        <span class="seclbl">CONJUNTO DE ÍCONES</span>
        <div class="row" data-for="s : iconsets"
             data-attr-setpath="s.path"
             data-class-sel="s.path == picker_sel"
             data-class-current="s.path == iconpath">
            {{ s.name }}<span class="scur" data-if="s.path == iconpath">✓ em uso</span>
        </div>
        <div id="styleclose">Fechar</div>
    </div>

</body>
</rml>
